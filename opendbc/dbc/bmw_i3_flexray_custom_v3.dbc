 SG_ LAT_STOCK_TORQUE_44_ALT_WORD_14_15 : 112|16@1- (1,0) [-32768|32767] "" BMW_I3
 SG_ LAT_STOCK_TORQUE_44_ICAN_HACK_NM : 88|12@1+ (0.005,-10) [-10|10.475] "Nm" BMW_I3
 SG_ LAT_STOCK_TORQUE_44_MODE_COPY : 103|4@0+ (1,0) [0|15] "" BMW_I3
