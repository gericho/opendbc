 SG_ LONG_TARGET_U_83 : 24|16@1+ (1,0) [0|65535] "" BMW_I3
 SG_ LONG_TARGET_SPEED_EST_83 : 24|16@1+ (0.047815,-1460.510) [0|300] "kph" BMW_I3
 SG_ LAT_TJA_BYTE_5 : 40|8@1+ (1,0) [0|255] "" BMW_I3
 SG_ LAT_TJA_BYTE_6 : 48|8@1+ (1,0) [0|255] "" BMW_I3
 SG_ LAT_TJA_BYTE_7 : 56|8@1+ (1,0) [0|255] "" BMW_I3
